# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Provider/model string uses pydantic-ai syntax, e.g.:
#   groq:openai/gpt-oss-120b
#   openai:gpt-4o-mini
# Leave FINANCE_MODEL empty to run in deterministic demo mode (no API key needed).
FINANCE_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=
# OPIK_URL=https://www.comet.com/opik   # override for self-hosted Opik
FINANCE_API_TOKENS=demo-admin-token:admin,demo-analyst-token:analyst,demo-viewer-token:viewer
CORS_ORIGINS=http://localhost:5173
